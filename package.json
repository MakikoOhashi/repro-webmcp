{
  "name": "repro-webmcp",
  "version": "0.1.3",
  "description": "Reproduce application states through a small developer CLI and runtime library.",
  "type": "module",
  "bin": {
    "repro": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./browser-bundle": {
      "types": "./dist/browser.bundle.d.ts",
      "import": "./dist/browser.bundle.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-browser-bundle.mjs",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "repro-webmcp": "^0.1.2",
    "wrangler": "^4.126.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MakikoOhashi/repro-webmcp.git"
  },
  "dependencies": {
    "typescript": "^5.0.0"
  }
}
